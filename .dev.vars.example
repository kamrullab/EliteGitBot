GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2$210000$base64-salt$base64-hash
SESSION_SECRET=replace-with-at-least-32-random-bytes
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# AI provider: rule-based, gemini, or openai-compatible
AI_ENABLED=false
AI_PROVIDER=rule-based
AI_MAX_INPUT_CHARS=50000
AI_PRIVATE_REPOSITORIES_ENABLED=false

# Any OpenAI-compatible API: OpenRouter, OpenAI, Groq, Together, external Ollama, etc.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
# Required allowlist for custom endpoints; comma-separated hostnames without paths.
AI_ALLOWED_HOSTS=openrouter.ai
