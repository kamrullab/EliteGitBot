{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elite-gitbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_ENABLED": "false",
    "AI_PROVIDER": "rule-based",
    "AI_MAX_INPUT_CHARS": "50000",
    "AI_PRIVATE_REPOSITORIES_ENABLED": "false"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "elite-gitbot",
    "database_id": "1a8d3c46-c604-4e0b-868e-5b983e1c0f54",
    "migrations_dir": "../../migrations"
  }],
  "queues": {
    "producers": [{ "binding": "EVENT_QUEUE", "queue": "elite-gitbot-events" }],
    "consumers": [{ "queue": "elite-gitbot-events", "max_batch_size": 5, "max_batch_timeout": 5, "max_retries": 3, "dead_letter_queue": "elite-gitbot-events-dlq" }]
  },
  "assets": { "directory": "../web/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] }
}
